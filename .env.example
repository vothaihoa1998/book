NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SUPABASE_URL=https://wwdkanwtfgzehjdhhwtc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__pzj0-rvZUkODuPwH14JCQ_FzDYqkyU

# Server-only. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Required in production for shared rate limits, Redis cache, and request deduplication.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MangaDex shared and per-user limits (safe defaults shown).
MANGADEX_API_RPS=4
MANGADEX_ATHOME_LIMIT=30
MANGADEX_RANDOM_LIMIT=45
MANGADEX_USER_API_LIMIT=60
MANGADEX_USER_SEARCH_LIMIT=20

# Finite local queue bounds.
MANGADEX_QUEUE_MAX=64
MANGADEX_QUEUE_WAIT_MS=5000
MANGADEX_QUEUE_CONCURRENCY=8
MANGADEX_QUEUE_PREFETCH_BUDGET=8

# Trusted proxy handling is opt-in; never trust forwarding headers unless the proxy is verified.
TRUSTED_PROXY=0
TRUSTED_PROXY_IP_HEADER=

# Protected monitoring: Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=

# Required in production to sign image proxy URLs. Generate a random secret of at least 32 bytes.
IMAGE_PROXY_SECRET=

# Optional source fallback.
FIRECRAWL_API_KEY=

# Optional only when running a local Supabase stack with Google Auth enabled.
# Hosted Supabase projects store Google Client ID/Secret in the Supabase Dashboard instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
